/* Styles partagés pour les emails FlexRoll */
body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #333;
    max-width: 600px;
    margin: 0 auto;
    padding: 20px;
    background-color: #f4f4f4;
}
.container {
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}
.header {
    text-align: center;
    padding-bottom: 20px;
    margin-bottom: 30px;
}
.header h1 { margin: 0; }
.content { margin-bottom: 30px; }
.btn {
    display: inline-block;
    padding: 12px 30px;
    color: white;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
    text-align: center;
}
.btn:hover { opacity: 0.95; }
.footer {
    text-align: center;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #ddd;
    font-size: 12px;
    color: #666;
}
.link-copy {
    background: #f8f9fa;
    padding: 15px;
    border-radius: 5px;
    margin-top: 20px;
    word-break: break-all;
    font-size: 12px;
    color: #666;
}
.password-box {
    padding: 20px;
    border-radius: 8px;
    text-align: center;
    margin: 25px 0;
}
.password-box .password {
    font-weight: bold;
    font-family: 'Courier New', monospace;
    letter-spacing: 2px;
    margin: 10px 0;
}
.info-box { padding: 15px; margin: 20px 0; border-radius: 4px; }
.warning { padding: 15px; margin: 20px 0; border-radius: 4px; }
.warning-box { padding: 15px; margin: 20px 0; border-radius: 4px; }
.security-tips { padding: 15px; margin: 20px 0; border-radius: 4px; }

/* Couleurs spécifiques */
.header--confirm { border-bottom: 3px solid #007bff; }
.header--confirm .header h1 { color: #007bff; }
.btn--confirm { background-color: #007bff; }
.btn--confirm:hover { background-color: #0056b3; }
.header--password { border-bottom: 3px solid #28a745; }
.btn--password { background-color: #28a745; }
.btn--password:hover { background-color: #218838; }
.header--reset { border-bottom: 3px solid #ffc107; }
.btn--reset { background-color: #ffc107; color: #333; }
.btn--reset:hover { background-color: #e0a800; }
.password-box--confirm { background: #f8f9fa; border: 2px solid #28a745; }
.password-box--reset { background: #fff3cd; border: 2px solid #ffc107; }
.info-box--confirm { background: #fff3cd; border-left: 4px solid #ffc107; }
.warning-box--reset { background: #f8d7da; border-left: 4px solid #dc3545; color: #721c24; }
.info-box--reset { background: #d1ecf1; border-left: 4px solid #0dcaf0; color: #055160; }
